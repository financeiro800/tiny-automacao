# Credenciais OAuth2 da API v3 do Tiny/Olist
# Gere em: ERP Tiny > Conta > Aplicativos/Integrações > "Nova aplicação"
TINY_CLIENT_ID=seu_client_id_aqui
TINY_CLIENT_SECRET=seu_client_secret_aqui

# Preenchido automaticamente pelo script na primeira autorização manual
# (veja o passo "Autorização inicial" no README.md)
TINY_REFRESH_TOKEN=

# Redirect URI cadastrada na aplicação. O Tiny exige um endereço que
# realmente responda (não aceita localhost fictício). Solução simples:
# gere uma URL grátis em https://webhook.site e cole aqui e no painel do Tiny.
TINY_REDIRECT_URI=https://webhook.site/SEU-ID-AQUI

# Opcional: e-mail/webhook para receber alertas quando o script encontrar
# algo que não conseguiu corrigir sozinho
ALERTA_EMAIL=
